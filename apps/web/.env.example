# =============================================================================
# Soteria Assurance — Web app (Next.js) public Firebase config
# =============================================================================
# Copy this file to `apps/web/.env.local` (git-ignored) and fill in the two
# values marked <FROM FIREBASE CONSOLE>. The other values are the project's
# public identifiers and can be used as-is.
#
# SOTERIA RULE 3 — every NEXT_PUBLIC_* value here is bundled into the client and
# is NOT secret. Secrets (ANTHROPIC_API_KEY, SENDGRID_API_KEY) live only in
# Firebase Functions via defineSecret() and must never appear here.
#
# When these are missing the app renders a "Configuration required" screen
# instead of the app (it no longer white-screens). Set all five required values
# to load the app.
#
# For hosting (Vercel / Firebase Hosting): set the SAME keys under the project's
# Environment Variables, then redeploy —
#   Vercel:  Project -> Settings -> Environment Variables
#   Firebase Hosting CI: repo -> Settings -> Secrets and variables -> Actions
#                        (as *Variables*, not Secrets)
#
# Get API_KEY and APP_ID from:
#   Firebase Console -> Project settings -> General -> Your apps -> Web app
#                    -> "SDK setup and configuration"
# =============================================================================

# --- Required ----------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=<FROM FIREBASE CONSOLE>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=soteria-assurance.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=soteria-assurance
# Confirm the exact bucket in the console — newer projects use
# `soteria-assurance.firebasestorage.app` instead of the `.appspot.com` form.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=soteria-assurance.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=<FROM FIREBASE CONSOLE>

# --- Optional ----------------------------------------------------------------
# Defaults to the project number (830573978482) when unset.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=830573978482
# Only when Google Analytics is enabled for the web app:
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Set to true only when running against the local Firebase Emulator Suite:
# NEXT_PUBLIC_USE_EMULATOR=false
