# Dependencies
node_modules/

# Build output
dist/
# ESM bundle of @soteria/core, consumed by the Supabase Edge Functions. Built,
# never committed — which means `pnpm build` must run before
# `supabase functions deploy`, or the functions will not resolve their import.
dist-esm/
build/
.next/
out/
web-build/
.expo/
# Functions' compiled output only — must NOT be a blanket `lib/`, which would
# also ignore source dirs like apps/web/lib/ (also covered by functions/.gitignore).
/functions/lib/

# Turborepo
.turbo/

# Test coverage
coverage/

# Logs
*.log
firebase-debug.log

# Environment
.env
.env.*
!.env.example

# Firebase
.firebase/

# Firebase Data Connect — generated SDKs (produced by dataconnect:sdk:generate)
packages/dataconnect-generated/
dataconnect/.dataconnect/

# TypeScript incremental
*.tsbuildinfo

# OS / editor
.DS_Store
*.local

# Safety net: TypeScript build output must never live in source trees
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
.vercel
