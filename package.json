{
  "name": "soteria-assurance",
  "version": "1.0.0",
  "private": true,
  "description": "ISO 45001:2018 AI-powered audit management platform \u2014 Turborepo monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "dev:web": "turbo run dev --filter=@soteria/web",
    "dev:mobile": "turbo run dev --filter=@soteria/mobile",
    "test:core": "turbo run test --filter=@soteria/core",
    "build:web": "turbo run build --filter=@soteria/web",
    "build:mobile": "turbo run build --filter=@soteria/mobile",
    "seed:demo": "node scripts/seed-demo.mjs",
    "superadmin:local": "node scripts/create-local-superadmin.mjs",
    "deploy": "pnpm build:web",
    "deploy:web": "pnpm build:web",
    "test:e2e": "sh -c 'SUPABASE_ANON_KEY=$(supabase status -o env | grep ^ANON_KEY= | cut -d= -f2- | tr -d \\\") SUPABASE_SERVICE_ROLE_KEY=$(supabase status -o env | grep ^SERVICE_ROLE_KEY= | cut -d= -f2- | tr -d \\\") pnpm --filter @soteria/e2e run test:e2e'"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.13.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    }
  }
}
